
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// PRODUCT CATEGORIES
// ==========================================

model Category {
  id   Int    @id @default(autoincrement())
  name String @unique
  slug String @unique

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// DAIRY PRODUCTS
// ==========================================

model Product {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  priceUgx    Int
  unit        String
  imageUrl    String?
  badge       String?
  isActive    Boolean @default(true)

  // Inventory in whole sellable units.
  stockQuantity Int @default(0)

  // Product category
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  // Customer order items
  orderItems OrderItem[]

  // Inventory movement history
  inventoryEvents InventoryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
}

// ==========================================
// CUSTOMER ROLES
// ==========================================

enum CustomerRole {
  CUSTOMER
  STAFF
}

// ==========================================
// CUSTOMER ACCOUNTS
// ==========================================

model Customer {
  id              String    @id @default(cuid())
  fullName        String
  email           String    @unique
  phone           String?
  passwordHash    String?
  emailVerifiedAt DateTime?
  isActive        Boolean   @default(true)

  role CustomerRole @default(CUSTOMER)

  // Authentication sessions
  sessions CustomerSession[]

  // Email verification and password reset
  actionTokens CustomerActionToken[]

  // Customer orders
  orders Order[]

  // Staff order status changes
  statusChangesMade OrderStatusEvent[] @relation("StaffOrderStatusChanges")

  // Staff delivery zone changes
  deliveryZoneChanges DeliveryZoneAuditEvent[] @relation("StaffDeliveryZoneChanges")

  // Staff inventory changes
  inventoryChanges InventoryEvent[] @relation("StaffInventoryChanges")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
}

// ==========================================
// CUSTOMER LOGIN SESSIONS
// ==========================================

model CustomerSession {
  id         String    @id @default(cuid())
  customerId String
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([expiresAt])
}

// ==========================================
// CUSTOMER ACTION TOKEN TYPES
// ==========================================

enum CustomerTokenPurpose {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

// ==========================================
// EMAIL VERIFICATION AND PASSWORD RESET
// ==========================================

model CustomerActionToken {
  id         String               @id @default(cuid())
  customerId String
  purpose    CustomerTokenPurpose
  tokenHash  String               @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime             @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, purpose])
  @@index([expiresAt])
}

// ==========================================
// FULFILLMENT METHODS
// ==========================================

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

// ==========================================
// PAYMENT METHODS
// ==========================================

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  CASH_ON_DELIVERY
  CASH_ON_PICKUP
  CARD
}

// ==========================================
// PAYMENT STATUSES
// ==========================================

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

// ==========================================
// ORDER STATUSES
// ==========================================

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

// ==========================================
// DELIVERY ZONES
// ==========================================

model DeliveryZone {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  slug     String  @unique
  feeUgx   Int
  isActive Boolean @default(false)

  orders Order[]

  auditEvents DeliveryZoneAuditEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ==========================================
// CUSTOMER ORDERS
// ==========================================

model Order {
  id          String @id @default(cuid())
  orderNumber String @unique

  // Customer relationship
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Fulfillment
  fulfillmentMethod FulfillmentMethod
  status            OrderStatus       @default(PENDING)

  // Payment
  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)

  // Customer contact details
  recipientName String
  contactPhone  String

  // Delivery details
  deliveryAddress      String?
  deliveryInstructions String?

  deliveryZoneId Int?
  deliveryZone   DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)

  // Delivery zone name snapshot
  deliveryZoneName String?

  // Amounts in Uganda shillings
  subtotalUgx    Int
  deliveryFeeUgx Int
  totalUgx       Int

  // Purchased items
  items OrderItem[]

  // Order status audit history
  statusEvents OrderStatusEvent[]

  // Inventory movements
  inventoryEvents InventoryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId, createdAt])
  @@index([status])
  @@index([deliveryZoneId])
}

// ==========================================
// ORDER ITEMS
// ==========================================

model OrderItem {
  id String @id @default(cuid())

  // Parent order
  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Product relationship
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Product snapshots at checkout
  productName String
  productUnit String

  // Price and quantity snapshots
  unitPriceUgx Int
  quantity     Int
  lineTotalUgx Int

  @@index([orderId])
  @@index([productId])
}

// ==========================================
// ORDER STATUS AUDIT HISTORY
// ==========================================

model OrderStatusEvent {
  id String @id @default(cuid())

  // Affected order
  orderId String
  order   Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Staff member making the change
  changedById String
  changedBy   Customer @relation("StaffOrderStatusChanges", fields: [changedById], references: [id], onDelete: Restrict)

  // Status transition
  fromStatus OrderStatus
  toStatus   OrderStatus

  // Staff explanation
  note String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([changedById, createdAt])
}

// ==========================================
// DELIVERY-ZONE AUDIT ACTIONS
// ==========================================

enum DeliveryZoneAuditAction {
  CREATED
  UPDATED
  ACTIVATED
  DEACTIVATED
}

// ==========================================
// DELIVERY-ZONE AUDIT HISTORY
// ==========================================

model DeliveryZoneAuditEvent {
  id String @id @default(cuid())

  // Affected delivery zone
  zoneId Int
  zone   DeliveryZone @relation(fields: [zoneId], references: [id], onDelete: Restrict)

  // Responsible staff account
  changedById String
  changedBy   Customer @relation("StaffDeliveryZoneChanges", fields: [changedById], references: [id], onDelete: Restrict)

  // Configuration change
  action DeliveryZoneAuditAction

  // Previous and new values
  previousValues Json?
  newValues      Json

  createdAt DateTime @default(now())

  @@index([zoneId, createdAt])
  @@index([changedById, createdAt])
}

// ==========================================
// INVENTORY ACTIONS
// MILESTONE 4.7.2
// ==========================================

enum InventoryAction {
  // Staff inventory adjustment
  STAFF_SET

  // Checkout stock deduction
  ORDER_PLACED

  // Stock restoration following cancellation
  ORDER_CANCELLED
}

// ==========================================
// INVENTORY MOVEMENT HISTORY
// ==========================================

model InventoryEvent {
  id String @id @default(cuid())

  // Product relationship
  productId Int?
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  // Historical product snapshots
  productName String
  productUnit String

  // Associated customer order
  orderId String?
  order   Order? @relation(fields: [orderId], references: [id], onDelete: Restrict)

  // Staff account responsible for changes
  // Null when checkout deducts inventory
  changedById String?
  changedBy   Customer? @relation("StaffInventoryChanges", fields: [changedById], references: [id], onDelete: Restrict)

  // Type of inventory movement
  action InventoryAction

  // Signed quantity change
  quantityChange Int

  // Previous quantity
  quantityBefore Int

  // New quantity
  quantityAfter Int

  // Explanation
  note String?

  // Audit timestamp
  createdAt DateTime @default(now())

  @@index([productId, createdAt])
  @@index([orderId])
  @@index([changedById, createdAt])
}
