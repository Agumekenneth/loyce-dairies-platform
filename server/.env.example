
# ==========================================
# LOYCE DAIRIES PLATFORM
# BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=5000

# Public frontend origin.
# Change to the deployed HTTPS frontend URL
# when configuring production.

CLIENT_URL=http://localhost:5173

# ==========================================
# POSTGRESQL DATABASE
# ==========================================

# Use a valid PostgreSQL connection string.
# Never commit actual database credentials.

DATABASE_URL=

# ==========================================
# EMAIL / SMTP CONFIGURATION
# ==========================================

# SMTP server hostname
SMTP_HOST=

# Common submission port: 587
# Use the port required by your provider.
SMTP_PORT=587

# Sender email address
SMTP_FROM=

# SMTP account credentials.
# Authentication is enabled only when
# BOTH username and password are provided.

SMTP_USER=
SMTP_PASSWORD=

# ==========================================
# PRODUCTION NOTES
# ==========================================

# In production:
# NODE_ENV=production
#
# Configure CLIENT_URL with the actual
# HTTPS frontend origin.
#
# Supply a secure production DATABASE_URL.
#
# Supply working SMTP configuration.
#
# Configure secrets through your hosting
# provider's environment settings.
#
# Never place real credentials in this file.
