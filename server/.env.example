# LOYCE DAIRIES — BACKEND CONFIGURATION
# Example values only. Never commit real credentials.

# Application
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL
DATABASE_URL=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Android USB development only
LOYCE_ANDROID_LOCAL_DEV=0

# Firebase Admin credentials
# Set this to the server's secure credential file path.
# Do not place Firebase service-account JSON in Git.
GOOGLE_APPLICATION_CREDENTIALS=

# Legacy direct Firebase delivery
# Keep disabled when persistent queue mode is enabled.
LOYCE_FCM_ORDER_PUSH_ENABLED=0

# Persistent notification queue
# Enable both flags together to activate queue delivery.
# Disabled by default until credentials and database
# migrations are configured.
LOYCE_FCM_QUEUE_ENABLED=0
LOYCE_FCM_QUEUE_WORKER_ENABLED=0

# Queue polling interval in milliseconds
LOYCE_FCM_QUEUE_INTERVAL_MS=15000

# Production deployment requirements:
# - Use HTTPS and an appropriate CLIENT_URL.
# - Configure PostgreSQL and secure credentials.
# - Apply Prisma migrations before starting the API.
# - Set both queue flags to 1 for persistent delivery.
# - Keep the legacy direct-send flag at 0.
# - Run the API and worker on reliable hosting.
